# cn-eye — .env shape. No secrets here: setup.sh copies this file to .env on the
# first run; edit .env freely. Comments on their own lines only (values run to
# end of line). Changing EYE_MEDIA_DIR = re-run ./setup.sh (the unit is rendered
# from it).
TZ=America/New_York
# Recordings root. Must be on a NON-root mount (the SD card): cn-eye.service
# BindsTo that mount and gates on the .cn-eye-volume marker setup.sh writes there.
EYE_MEDIA_DIR=/mnt/sd/eye
# Size cap, whole GiB, for EYE_MEDIA_DIR; the prune janitor deletes the oldest
# movies above it. motionEye's own "preserve movies" (days) applies on top.
EYE_MAX_GB=50
# Seconds between janitor passes.
EYE_PRUNE_INTERVAL=300
